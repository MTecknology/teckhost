[Unit]
Description=Self-managed ansible run
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/ansible
ExecStart=/usr/bin/git fetch
ExecStart=/usr/bin/git reset --hard @{upstream}
ExecStart=/usr/bin/ansible-playbook conf/maintenance.yml

[Install]
WantedBy=multi-user.target
